{
  "version": 8,
  "name": "LovedOnes Vector Style",
  "glyphs": "/tiles/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles:///tiles/region.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#cfe3ee"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#f3f2ed"
      }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "kind"],
        ["literal", ["residential", "commercial", "industrial", "university", "hospital", "school", "college"]]
      ],
      "paint": {
        "fill-color": "#eeede7",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "kind"],
        [
          "literal",
          ["park", "grass", "wood", "scrub", "meadow", "recreation_ground", "garden", "playground", "pitch", "cemetery", "farmland"]
        ]
      ],
      "paint": {
        "fill-color": "#d5e8ce",
        "fill-opacity": 0.82
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#bfe0f0"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "LineString"],
      "paint": {
        "line-color": "#bfe0f0",
        "line-width": [
          "match",
          ["get", "kind"],
          "river",
          3.2,
          "canal",
          2.4,
          1.2
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e6e4dd",
        "fill-outline-color": "#d6d3cb",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0,
          14.5,
          0.95
        ]
      }
    },
    {
      "id": "roads-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "rail"],
      "minzoom": 11,
      "paint": {
        "line-color": "#cbd5e1",
        "line-dasharray": [3, 3],
        "line-width": 1.1
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["!", ["in", ["get", "kind"], ["literal", ["rail", "path"]]]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d4d8dd",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          ["match", ["get", "kind"], "highway", 3.2, "major_road", 2.0, 0.8],
          15,
          ["match", ["get", "kind"], "highway", 8.5, "major_road", 6.2, 4.2]
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["!", ["in", ["get", "kind"], ["literal", ["rail", "path"]]]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          ["get", "kind"],
          "highway",
          "#ffffff",
          "major_road",
          "#ffffff",
          "#fafaf9"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          ["match", ["get", "kind"], "highway", 2.0, "major_road", 1.2, 0.4],
          15,
          ["match", ["get", "kind"], "highway", 6.5, "major_road", 4.6, 2.8]
        ]
      }
    },
    {
      "id": "roads-paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "path"],
      "minzoom": 14,
      "paint": {
        "line-color": "#dcdad3",
        "line-dasharray": [2, 2],
        "line-width": 1.0
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#94a3b8",
        "line-dasharray": [2, 2],
        "line-width": 1
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water",
      "minzoom": 11,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["has", "name"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name:en"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 15, 12],
        "text-letter-spacing": 0.04,
        "symbol-spacing": 380
      },
      "paint": {
        "text-color": "#4b7b94",
        "text-halo-color": "rgba(232, 245, 251, 0.92)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": ["all", ["!", ["in", ["get", "kind"], ["literal", ["rail", "path"]]]], ["has", "name"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name:en"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12,
          10,
          14,
          11.5,
          17,
          13.5
        ],
        "text-max-angle": 45,
        "text-padding": 3,
        "symbol-spacing": 200
      },
      "paint": {
        "text-color": "#3f444e",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.8,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "pois-parks-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "minzoom": 13,
      "filter": [
        "all",
        ["in", ["get", "kind"], ["literal", ["park", "recreation_ground", "garden", "wood"]]],
        ["has", "name"]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name:en"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10.5, 16, 12],
        "text-max-width": 9,
        "text-padding": 6
      },
      "paint": {
        "text-color": "#456847",
        "text-halo-color": "rgba(255, 255, 255, 0.9)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "pois-landmarks-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "in",
          ["get", "kind"],
          ["literal", ["station", "university", "hospital", "museum", "attraction", "historic", "library", "stadium"]]
        ],
        ["has", "name"]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name:en"]],
        "text-font": ["PlusJakartaSans-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10.5, 16, 12],
        "text-max-width": 9,
        "text-padding": 6
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "rgba(255, 255, 255, 0.92)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "places-neighborhoods",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "places",
      "minzoom": 11,
      "filter": ["!", ["in", ["get", "kind"], ["literal", ["locality", "country", "region"]]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name:en"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 14, 13.5],
        "text-max-width": 9,
        "text-padding": 8
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.9
      }
    },
    {
      "id": "places-cities",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "places",
      "minzoom": 3,
      "filter": ["in", ["get", "kind"], ["literal", ["locality", "country", "region"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name:en"]],
        "text-font": ["PlusJakartaSans-SemiBold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 10, 15, 13, 18],
        "text-max-width": 8,
        "text-padding": 10
      },
      "paint": {
        "text-color": "#18181b",
        "text-halo-color": "rgba(255, 255, 255, 0.96)",
        "text-halo-width": 2.2
      }
    }
  ]
}
