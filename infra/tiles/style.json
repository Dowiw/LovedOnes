{
  "version": 8,
  "name": "LovedOnes Vector Style",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles:///tiles/region.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#cfe3ee"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#f3f2ed"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#d5e8ce",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#bfe0f0"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "buildings",
      "paint": {
        "fill-color": "#e6e4dd",
        "fill-outline-color": "#d6d3cb"
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "paint": {
        "line-color": "#d4d8dd",
        "line-width": [
          "match",
          ["get", "kind"],
          "highway",
          4.2,
          "major_road",
          3.0,
          1.8
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "paint": {
        "line-color": [
          "match",
          ["get", "kind"],
          "highway",
          "#ffffff",
          "major_road",
          "#ffffff",
          "#f8fafc"
        ],
        "line-width": [
          "match",
          ["get", "kind"],
          "highway",
          2.6,
          "major_road",
          1.8,
          1.0
        ]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#94a3b8",
        "line-dasharray": [2, 2],
        "line-width": 1
      }
    }
  ]
}
