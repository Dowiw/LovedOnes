{
  "version": 8,
  "name": "LovedOnes Vector Style",
  "sprite": "/tiles/sprites/maki",
  "glyphs": "/tiles/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles:///tiles/region.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#cfe3ee"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#f3f2ed"
      }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "kind"],
        ["literal", ["residential", "commercial", "industrial", "university", "hospital", "school", "college"]]
      ],
      "paint": {
        "fill-color": "#eeede7",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "kind"],
        [
          "literal",
          ["park", "grass", "wood", "scrub", "meadow", "recreation_ground", "garden", "playground", "pitch", "cemetery", "farmland"]
        ]
      ],
      "paint": {
        "fill-color": "#d5e8ce",
        "fill-opacity": 0.82
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#bfe0f0"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "LineString"],
      "paint": {
        "line-color": "#bfe0f0",
        "line-width": [
          "match",
          ["get", "kind"],
          "river",
          3.2,
          "canal",
          2.4,
          1.2
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e6e4dd",
        "fill-outline-color": "#d6d3cb",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0,
          14.5,
          0.95
        ]
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["!", ["in", ["get", "kind"], ["literal", ["rail", "path"]]]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d4d8dd",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          ["match", ["get", "kind"], "highway", 3.2, "major_road", 2.0, 0.8],
          15,
          ["match", ["get", "kind"], "highway", 8.5, "major_road", 6.2, 4.2]
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["!", ["in", ["get", "kind"], ["literal", ["rail", "path"]]]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          ["get", "kind"],
          "highway",
          "#ffffff",
          "major_road",
          "#ffffff",
          "#fafaf9"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          ["match", ["get", "kind"], "highway", 2.0, "major_road", 1.2, 0.4],
          15,
          ["match", ["get", "kind"], "highway", 6.5, "major_road", 4.6, 2.8]
        ]
      }
    },
    {
      "id": "roads-paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "path"],
      "minzoom": 14,
      "paint": {
        "line-color": "#dcdad3",
        "line-dasharray": [2, 2],
        "line-width": 1.0
      }
    },
    {
      "id": "roads-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "rail"],
      "minzoom": 11,
      "paint": {
        "line-color": "#94a3b8",
        "line-dasharray": [3, 3],
        "line-width": 1.3
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#94a3b8",
        "line-dasharray": [2, 2],
        "line-width": 1
      }
    },
    {
      "id": "buildings-housenumbers",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "buildings",
      "minzoom": 16.5,
      "filter": ["has", "addr_housenumber"],
      "layout": {
        "text-field": ["get", "addr_housenumber"],
        "text-font": ["PlusJakartaSans-Regular"],
        "text-size": 9.5,
        "text-padding": 2
      },
      "paint": {
        "text-color": "#94a3b8",
        "text-halo-color": "rgba(255, 255, 255, 0.85)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "pois-food-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "minzoom": 14.5,
      "filter": [
        "all",
        [
          "in",
          ["get", "kind"],
          ["literal", ["restaurant", "cafe", "bakery", "fast_food", "bar", "ice_cream", "canteen"]]
        ],
        ["has", "name"]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "kind"],
          "cafe",
          "cafe",
          "bakery",
          "bakery",
          "fast_food",
          "fast-food",
          "bar",
          "bar",
          "ice_cream",
          "ice-cream",
          "restaurant"
        ],
        "icon-size": 0.78,
        "icon-anchor": "bottom",
        "icon-padding": 2,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14.5, 10, 17, 11.5],
        "text-anchor": "top",
        "text-offset": [0, 0.28],
        "text-max-width": 9,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#9a5828",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "pois-retail-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "minzoom": 13.8,
      "filter": [
        "all",
        [
          "in",
          ["get", "kind"],
          [
            "literal",
            [
              "supermarket",
              "mall",
              "convenience",
              "chemist",
              "department_store",
              "marketplace",
              "bank",
              "hotel",
              "furniture",
              "florist",
              "jewelry",
              "optician",
              "mobile_phone",
              "kiosk",
              "wine",
              "beverages",
              "commercial",
              "art",
              "gallery",
              "fitness_centre",
              "sports_centre",
              "sports_hall"
            ]
          ]
        ],
        ["has", "name"]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "kind"],
          ["supermarket", "convenience", "marketplace"],
          "grocery",
          "bank",
          "bank",
          "hotel",
          "lodging",
          "furniture",
          "furniture",
          "florist",
          "florist",
          "jewelry",
          "jewelry-store",
          ["art", "gallery"],
          "art-gallery",
          "fitness_centre",
          "fitness-centre",
          ["sports_centre", "sports_hall"],
          "soccer",
          "commercial",
          "commercial",
          "shop"
        ],
        "icon-size": 0.78,
        "icon-anchor": "bottom",
        "icon-padding": 2,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13.8, 10, 17, 12],
        "text-anchor": "top",
        "text-offset": [0, 0.28],
        "text-max-width": 9,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#356299",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water",
      "minzoom": 11,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["has", "name"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 15, 12],
        "text-letter-spacing": 0.04,
        "symbol-spacing": 520
      },
      "paint": {
        "text-color": "#4b7b94",
        "text-halo-color": "rgba(232, 245, 251, 0.92)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "road-labels-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 14.5,
      "filter": [
        "all",
        ["==", ["get", "kind"], "minor_road"],
        ["!", ["has", "service"]],
        ["has", "name"]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14.5, 10, 17, 12],
        "text-max-angle": 35,
        "text-padding": 18,
        "symbol-spacing": 620
      },
      "paint": {
        "text-color": "#525866",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.7,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": [
        "all",
        ["in", ["get", "kind"], ["literal", ["highway", "major_road"]]],
        ["!", ["has", "service"]],
        ["has", "name"]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12,
          10,
          14,
          11.5,
          17,
          13
        ],
        "text-max-angle": 35,
        "text-padding": 16,
        "symbol-spacing": 560
      },
      "paint": {
        "text-color": "#3f444e",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.8,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "pois-parks-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "minzoom": 12.5,
      "filter": [
        "all",
        ["in", ["get", "kind"], ["literal", ["park", "recreation_ground", "garden", "wood", "cemetery", "beach", "playground"]]],
        ["has", "name"]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "kind"],
          "garden",
          "garden",
          "cemetery",
          "cemetery",
          "beach",
          "beach",
          "playground",
          "playground",
          "park"
        ],
        "icon-size": 0.78,
        "icon-anchor": "bottom",
        "icon-padding": 2,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12.5, 10.5, 16, 12],
        "text-anchor": "top",
        "text-offset": [0, 0.28],
        "text-max-width": 9,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#456847",
        "text-halo-color": "rgba(255, 255, 255, 0.92)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "pois-health-local",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "minzoom": 14,
      "filter": [
        "all",
        ["in", ["get", "kind"], ["literal", ["pharmacy", "doctors", "dentist", "medical_supply"]]],
        ["has", "name"]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "kind"],
          "pharmacy",
          "pharmacy",
          "dentist",
          "dentist",
          "doctor"
        ],
        "icon-size": 0.78,
        "icon-anchor": "bottom",
        "icon-padding": 2,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 17, 11.5],
        "text-anchor": "top",
        "text-offset": [0, 0.28],
        "text-max-width": 9,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#c23648",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "pois-civic-local",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "minzoom": 14.2,
      "filter": [
        "all",
        ["in", ["get", "kind"], ["literal", ["school", "kindergarten", "tram_stop", "bus_stop", "subway_entrance"]]],
        ["has", "name"]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "kind"],
          "tram_stop",
          "rail-light",
          "bus_stop",
          "bus",
          "subway_entrance",
          "rail-metro",
          "school"
        ],
        "icon-size": 0.78,
        "icon-anchor": "bottom",
        "icon-padding": 2,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14.2, 10, 17, 11.5],
        "text-anchor": "top",
        "text-offset": [0, 0.28],
        "text-max-width": 9,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "pois-landmarks-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "minzoom": 12.5,
      "filter": [
        "all",
        [
          "in",
          ["get", "kind"],
          [
            "literal",
            [
              "station",
              "university",
              "college",
              "research_institute",
              "museum",
              "attraction",
              "historic",
              "library",
              "stadium",
              "police",
              "post_office",
              "place_of_worship",
              "church",
              "community_centre"
            ]
          ]
        ],
        ["has", "name"]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "kind"],
          "station",
          "rail",
          ["university", "college", "research_institute"],
          "college",
          "museum",
          "museum",
          "library",
          "library",
          "police",
          "police",
          "post_office",
          "post",
          "historic",
          "monument",
          "stadium",
          "stadium",
          ["place_of_worship", "church"],
          "place-of-worship",
          "community_centre",
          "town-hall",
          "attraction"
        ],
        "icon-size": 0.78,
        "icon-anchor": "bottom",
        "icon-padding": 2,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12.5, 10.5, 16, 12.5],
        "text-anchor": "top",
        "text-offset": [0, 0.28],
        "text-max-width": 9,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#2c5b8c",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.7
      }
    },
    {
      "id": "pois-health-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "minzoom": 12.5,
      "filter": [
        "all",
        ["in", ["get", "kind"], ["literal", ["hospital", "social_facility"]]],
        ["has", "name"]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "kind"],
          "social_facility",
          "heart",
          "hospital"
        ],
        "icon-size": 0.82,
        "icon-anchor": "bottom",
        "icon-padding": 2,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-SemiBold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12.5, 10.5, 16, 12.5],
        "text-anchor": "top",
        "text-offset": [0, 0.28],
        "text-max-width": 9,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#be123c",
        "text-halo-color": "rgba(255, 255, 255, 0.96)",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "places-neighborhoods",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "places",
      "minzoom": 11,
      "filter": ["!", ["in", ["get", "kind"], ["literal", ["locality", "country", "region"]]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 14, 13.5],
        "text-max-width": 9,
        "text-padding": 8
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "rgba(255, 255, 255, 0.94)",
        "text-halo-width": 1.9
      }
    },
    {
      "id": "places-cities",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "places",
      "minzoom": 3,
      "filter": ["in", ["get", "kind"], ["literal", ["locality", "country", "region"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["PlusJakartaSans-SemiBold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 10, 15, 13, 18],
        "text-max-width": 8,
        "text-padding": 10
      },
      "paint": {
        "text-color": "#18181b",
        "text-halo-color": "rgba(255, 255, 255, 0.96)",
        "text-halo-width": 2.2
      }
    }
  ]
}
