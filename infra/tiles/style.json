{
  "version": 8,
  "name": "LovedOnes Vector Style",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles:///tiles/region.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0b1120"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#0f172a"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1e3a5f"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#132238",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "buildings",
      "paint": {
        "fill-color": "#1e293b",
        "fill-outline-color": "#334155"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "paint": {
        "line-color": [
          "match",
          ["get", "kind"],
          "highway",
          "#64748b",
          "major_road",
          "#475569",
          "#334155"
        ],
        "line-width": [
          "match",
          ["get", "kind"],
          "highway",
          2.2,
          "major_road",
          1.5,
          1.0
        ]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#475569",
        "line-dasharray": [2, 2],
        "line-width": 1
      }
    }
  ]
}
