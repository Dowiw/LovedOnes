{
  "expo": {
    "name": "LovedOnes",
    "slug": "loved-ones",
    "version": "0.1.2",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "notification": {
      "icon": "./assets/monochrome-icon.png",
      "color": "#09090b"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "lovedones",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.lovedones.app",
      "buildNumber": "3",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share your live location with authorized family groups.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Continue sharing background location updates with your group while the app is minimized.",
        "NSCameraUsageDescription": "Scan zero-config onboarding QR codes from your host admin dashboard.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "org.lovedones.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#09090b"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LovedOnes to share location updates in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LovedOnes to scan QR invite codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LovedOnes to choose and crop your profile photo.",
          "cameraPermission": "Allow LovedOnes to take a profile photo."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite",
      "@maplibre/maplibre-react-native"
    ]
  }
}
