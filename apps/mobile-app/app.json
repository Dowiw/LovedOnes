{
  "expo": {
    "name": "LovedOnes",
    "slug": "loved-ones",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "lovedones",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.lovedones.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share your live location with authorized family groups.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Continue sharing background location updates with your group while the app is minimized.",
        "NSCameraUsageDescription": "Scan zero-config onboarding QR codes from your host admin dashboard.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "package": "org.lovedones.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LovedOnes to share location updates in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LovedOnes to scan QR invite codes."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "@maplibre/maplibre-react-native"
    ]
  }
}
