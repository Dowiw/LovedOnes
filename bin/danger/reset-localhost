#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

DEFAULT_POSTGIS_AMD64="postgis/postgis:16-3.4-alpine"
DEFAULT_POSTGIS_ARM64="imresamu/postgis:16-3.4-alpine"

CONFIRM_RESET=0
DEV_MODE=0
FRESH_ENV=0
WIPE_LOGS=0
WIPE_TILES=0
DRY_RUN=0

print_usage() {
  cat <<'EOF'
DANGER: Localhost Full Account Reset & Rebuild Helper

Usage: ./bin/danger/reset-localhost [options]

Wipes all local PostgreSQL and Redis Docker volumes (deleting every account,
group, place, location ping, chat message, session, and HTTP/Overland tracker
token) and rebuilds a clean LovedOnes stack on localhost.

Options:
  --confirm-reset  Skip interactive "RESET" confirmation prompt (required for
                   non-interactive/CI runs).
  --dev            Target docker-compose.dev.yml instead of full docker-compose.yml.
  --fresh-env      Back up existing .env (if present) and initialize clean localhost
                   defaults from .env.example with fresh JWT secrets.
  --wipe-logs      Remove log files inside ./logs/ (preserving .gitkeep).
  --wipe-tiles     Remove downloaded city extracts in ./infra/tiles/regions/
                   (preserving tracked style/fonts/sprites/stub).
  --dry-run        Print planned actions without deleting volumes or running Compose.
  -h, --help       Show this help message.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --confirm-reset)
      CONFIRM_RESET=1
      shift
      ;;
    --dev)
      DEV_MODE=1
      shift
      ;;
    --fresh-env)
      FRESH_ENV=1
      shift
      ;;
    --wipe-logs)
      WIPE_LOGS=1
      shift
      ;;
    --wipe-tiles)
      WIPE_TILES=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      print_usage >&2
      exit 1
      ;;
  esac
done

generate_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
  elif command -v node >/dev/null 2>&1; then
    node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
  else
    LC_ALL=C tr -dc 'a-f0-9' </dev/urandom | head -c 64
  fi
}

upsert_env_var() {
  key="$1"
  val="$2"
  file="${3:-.env}"
  [ -f "$file" ] || : > "$file"
  tmp_file="${file}.tmp.$$"
  LO_KEY="$key" LO_VAL="$val" awk '
    BEGIN { k = ENVIRON["LO_KEY"]; v = ENVIRON["LO_VAL"]; updated = 0 }
    index($0, "=") > 0 && $0 !~ /^[[:space:]]*#/ {
      eq = index($0, "=")
      lhs = substr($0, 1, eq - 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", lhs)
      if (lhs == k) {
        if (!updated) {
          print k "=" v
          updated = 1
        }
        next
      }
    }
    { print }
    END {
      if (!updated) {
        print k "=" v
      }
    }
  ' "$file" > "$tmp_file"
  mv "$tmp_file" "$file"
}

ARCH="$(uname -m 2>/dev/null || echo unknown)"
DETECTED_POSTGIS_IMAGE="$DEFAULT_POSTGIS_AMD64"
case "$ARCH" in
  arm64|aarch64)
    DETECTED_POSTGIS_IMAGE="$DEFAULT_POSTGIS_ARM64"
    ;;
esac

if [ "$DEV_MODE" -eq 1 ]; then
  COMPOSE_FILE="docker-compose.dev.yml"
  STACK_LABEL="dev backing stack (docker-compose.dev.yml)"
else
  COMPOSE_FILE="docker-compose.yml"
  STACK_LABEL="full localhost stack (docker-compose.yml)"
fi

cat <<EOF
========================================================================
  DANGER: LOVEDONES LOCALHOST FULL ACCOUNT RESET
========================================================================
Target stack : ${STACK_LABEL}
Host arch    : ${ARCH} (PostGIS image: ${DETECTED_POSTGIS_IMAGE})

THIS WILL PERMANENTLY WIPE:
  - PostgreSQL volume (all accounts, groups, invites, places, location history,
    chat messages, share links, registration requests, and server settings)
  - Redis volume (all sessions, active TrackerTokens/Overland tokens,
    telemetry counters, and live log ring buffer)
  - Caddy state volumes (for the selected Compose project)
EOF

if [ "$FRESH_ENV" -eq 1 ]; then
  echo "  - .env will be backed up and recreated with fresh localhost JWT secrets"
fi
if [ "$WIPE_LOGS" -eq 1 ]; then
  echo "  - Local log files under ./logs/ (preserving .gitkeep)"
fi
if [ "$WIPE_TILES" -eq 1 ]; then
  echo "  - Downloaded regional extracts under ./infra/tiles/regions/ (preserving base style/fonts/sprites/stub)"
else
  echo ""
  echo "PRESERVED BY DEFAULT:"
  echo "  - Downloaded PMTiles archives in ./infra/tiles/ (pass --wipe-tiles to clear)"
  if [ "$WIPE_LOGS" -eq 0 ]; then
    echo "  - Local log files in ./logs/ (pass --wipe-logs to clear)"
  fi
fi
echo "========================================================================"

if [ "$CONFIRM_RESET" -ne 1 ]; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "Refusing to wipe non-interactively without --confirm-reset." >&2
    exit 1
  fi
  printf 'Type RESET (all caps) to permanently wipe local accounts and rebuild: '
  IFS= read -r answer || answer=""
  if [ "$answer" != "RESET" ]; then
    echo "Aborted. Nothing was modified."
    exit 1
  fi
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Error: docker CLI not found on PATH." >&2
  exit 1
fi

run_cmd() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

echo ""
echo "-> Stopping containers and removing Docker volumes (${COMPOSE_FILE})..."
run_cmd env POSTGIS_IMAGE="${POSTGIS_IMAGE:-$DETECTED_POSTGIS_IMAGE}" \
  docker compose -f "$COMPOSE_FILE" down -v --remove-orphans

if [ "$FRESH_ENV" -eq 1 ]; then
  if [ -f ".env" ]; then
    backup_name=".env.backup.$(date +%Y%m%d-%H%M%S)"
    echo "-> Backing up existing .env to ${backup_name}..."
    run_cmd cp ".env" "$backup_name"
  fi
  echo "-> Initializing clean localhost .env from .env.example..."
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "[dry-run] copy .env.example -> .env and set fresh JWT_SECRET, JWT_REFRESH_SECRET, PUBLIC_SERVER_URL=http://localhost:8080, POSTGIS_IMAGE=${DETECTED_POSTGIS_IMAGE}"
  else
    if [ -f ".env.example" ]; then
      cp ".env.example" ".env"
    else
      : > ".env"
    fi
    upsert_env_var "JWT_SECRET" "$(generate_secret)" ".env"
    upsert_env_var "JWT_REFRESH_SECRET" "$(generate_secret)" ".env"
    upsert_env_var "PUBLIC_SERVER_URL" "http://localhost:8080" ".env"
    upsert_env_var "POSTGIS_IMAGE" "$DETECTED_POSTGIS_IMAGE" ".env"
  fi
fi

if [ "$WIPE_LOGS" -eq 1 ] && [ -d "./logs" ]; then
  echo "-> Clearing local log files under ./logs/ (preserving .gitkeep)..."
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "[dry-run] find ./logs -mindepth 1 ! -name '.gitkeep' -delete"
  else
    find ./logs -mindepth 1 ! -name '.gitkeep' -delete
  fi
fi

if [ "$WIPE_TILES" -eq 1 ] && [ -d "./infra/tiles/regions" ]; then
  echo "-> Clearing downloaded regional PMTiles extracts under ./infra/tiles/regions/..."
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "[dry-run] find ./infra/tiles/regions -mindepth 1 ! -name '.gitkeep' -delete"
  else
    find ./infra/tiles/regions -mindepth 1 ! -name '.gitkeep' -delete
  fi
fi

echo "-> Rebuilding and starting ${STACK_LABEL}..."
if [ "$DEV_MODE" -eq 1 ]; then
  run_cmd env POSTGIS_IMAGE="${POSTGIS_IMAGE:-$DETECTED_POSTGIS_IMAGE}" \
    docker compose -f "$COMPOSE_FILE" up -d --wait
else
  run_cmd env POSTGIS_IMAGE="${POSTGIS_IMAGE:-$DETECTED_POSTGIS_IMAGE}" \
    docker compose -f "$COMPOSE_FILE" up -d --build --wait
fi

echo ""
if [ "$DRY_RUN" -eq 1 ]; then
  echo "Dry-run complete. No volumes or files were modified."
else
  echo "Fresh localhost reset complete! Visit http://localhost:8080 to create a brand-new Host Admin account."
fi
