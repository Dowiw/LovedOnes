#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT_DIR"

DEFAULT_JWT_SECRET="dev-jwt-secret-key-minimum-32-characters-long"
DEFAULT_JWT_REFRESH_SECRET="dev-jwt-refresh-secret-key-min-32-chars"
DEFAULT_POSTGIS_AMD64="postgis/postgis:16-3.4-alpine"
DEFAULT_POSTGIS_ARM64="imresamu/postgis:16-3.4-alpine"
BUILDS_METADATA_URL="https://build-metadata.protomaps.dev/builds.json"

AUTO_MODE=0
CONFIGURE_MODE=0
SKIP_UPDATE_CHECK=0
DRY_RUN=0
COMPOSE_ARGS=""

print_usage() {
  cat <<'EOF'
Usage: ./bin/start [options] [docker compose up options...]

Options:
  --auto, -y, --non-interactive  Run unattended in one pass: auto-pull fast-forward
                                 updates when clean, initialize missing .env defaults
                                 (including arm64 POSTGIS_IMAGE), and start Compose.
  --configure, --reconfigure     Prompt through all .env and tile setup questions
                                 even when .env already exists.
  --skip-update                  Skip the git upstream version check.
  --dry-run                      Run setup/update prompts without modifying Compose state.
  -h, --help                     Show this help message.

Any additional flags (for example: --wait, --no-build) are passed to
`docker compose up -d --build`.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --auto|-y|--yes|--non-interactive)
      AUTO_MODE=1
      shift
      ;;
    --configure|--reconfigure)
      CONFIGURE_MODE=1
      shift
      ;;
    --skip-update)
      SKIP_UPDATE_CHECK=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    *)
      # Escape single quotes for safe eval reconstruction of passthrough compose args
      escaped_arg="$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
      COMPOSE_ARGS="${COMPOSE_ARGS} '${escaped_arg}'"
      shift
      ;;
  esac
done

IS_TTY=0
if [ -t 0 ] && [ -t 1 ]; then
  IS_TTY=1
fi

INTERACTIVE=0
if [ "$AUTO_MODE" -eq 0 ] && [ "$IS_TTY" -eq 1 ]; then
  INTERACTIVE=1
fi

generate_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
  elif command -v node >/dev/null 2>&1; then
    node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
  else
    LC_ALL=C tr -dc 'a-f0-9' </dev/urandom | head -c 64
  fi
}

get_env_var() {
  key="$1"
  file="${2:-.env}"
  [ -f "$file" ] || return 0
  LO_KEY="$key" awk '
    BEGIN { k = ENVIRON["LO_KEY"]; val = "" }
    $0 ~ /^[[:space:]]*#/ { next }
    index($0, "=") > 0 {
      eq = index($0, "=")
      lhs = substr($0, 1, eq - 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", lhs)
      if (lhs == k) {
        rhs = substr($0, eq + 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", rhs)
        if ((substr(rhs, 1, 1) == "\"" && substr(rhs, length(rhs), 1) == "\"") ||
            (substr(rhs, 1, 1) == "\047" && substr(rhs, length(rhs), 1) == "\047")) {
          if (length(rhs) >= 2) {
            rhs = substr(rhs, 2, length(rhs) - 2)
          }
        }
        val = rhs
      }
    }
    END { printf "%s", val }
  ' "$file"
}

upsert_env_var() {
  key="$1"
  val="$2"
  file="${3:-.env}"
  [ -f "$file" ] || : > "$file"
  tmp_file="${file}.tmp.$$"
  LO_KEY="$key" LO_VAL="$val" awk '
    BEGIN { k = ENVIRON["LO_KEY"]; v = ENVIRON["LO_VAL"]; updated = 0 }
    index($0, "=") > 0 && $0 !~ /^[[:space:]]*#/ {
      eq = index($0, "=")
      lhs = substr($0, 1, eq - 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", lhs)
      if (lhs == k) {
        if (!updated) {
          print k "=" v
          updated = 1
        }
        next
      }
    }
    { print }
    END {
      if (!updated) {
        print k "=" v
      }
    }
  ' "$file" > "$tmp_file"
  mv "$tmp_file" "$file"
}

read_pkg_version() {
  awk '
    /"version"[[:space:]]*:/ {
      line = $0
      sub(/.*"version"[[:space:]]*:[[:space:]]*"/, "", line)
      sub(/".*/, "", line)
      print line
      exit
    }
  '
}

prompt_yes_no() {
  question="$1"
  default_ans="$2" # Y or N
  if [ "$default_ans" = "Y" ]; then
    hint="[Y/n]"
  else
    hint="[y/N]"
  fi
  while true; do
    printf '%s %s ' "$question" "$hint"
    IFS= read -r reply || reply=""
    reply="$(printf '%s' "$reply" | tr -d '\r' | awk '{$1=$1;print}')"
    if [ -z "$reply" ]; then
      [ "$default_ans" = "Y" ] && return 0 || return 1
    fi
    case "$reply" in
      y|Y|yes|YES) return 0 ;;
      n|N|no|NO) return 1 ;;
      *) echo "Please answer y or n." ;;
    esac
  done
}

prompt_value() {
  label="$1"
  default_val="$2"
  secret_mode="${3:-0}"
  if [ "$secret_mode" -eq 1 ] && [ -n "$default_val" ]; then
    printf '%s [currently set, press Enter to keep, or type "clear"]: ' "$label" >&2
  elif [ -n "$default_val" ]; then
    printf '%s [%s]: ' "$label" "$default_val" >&2
  else
    printf '%s (optional, Enter to skip): ' "$label" >&2
  fi
  IFS= read -r reply || reply=""
  reply="$(printf '%s' "$reply" | tr -d '\r')"
  if [ -z "$reply" ]; then
    printf '%s' "$default_val"
  elif [ "$secret_mode" -eq 1 ] && [ "$reply" = "clear" ]; then
    printf ''
  else
    printf '%s' "$reply"
  fi
}

check_and_update_repo() {
  [ "$SKIP_UPDATE_CHECK" -eq 0 ] || return 0
  command -v git >/dev/null 2>&1 || return 0
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

  cur_version="unknown"
  if [ -f package.json ]; then
    cur_version="$(read_pkg_version < package.json)"
    cur_version="${cur_version:-unknown}"
  fi
  cur_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'HEAD')"
  cur_sha="$(git rev-parse --short HEAD 2>/dev/null || echo 'unknown')"

  echo "Checking version against git remote..."
  fetch_ok=0
  if command -v timeout >/dev/null 2>&1; then
    if timeout 15 git fetch --tags --prune --quiet 2>/dev/null; then
      fetch_ok=1
    fi
  else
    if git fetch --tags --prune --quiet 2>/dev/null; then
      fetch_ok=1
    fi
  fi

  if [ "$fetch_ok" -eq 0 ]; then
    echo "Current version: v${cur_version} (${cur_branch}@${cur_sha}) [offline or remote unreachable; skipping update check]"
    return 0
  fi

  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [ -z "$upstream" ] && git rev-parse --verify --quiet "origin/${cur_branch}" >/dev/null 2>&1; then
    upstream="origin/${cur_branch}"
  fi

  if [ -z "$upstream" ]; then
    echo "Current version: v${cur_version} (${cur_branch}@${cur_sha}) [no upstream tracking branch configured]"
    return 0
  fi

  rem_sha="$(git rev-parse --short "$upstream" 2>/dev/null || echo 'unknown')"
  behind="$(git rev-list --count "HEAD..${upstream}" 2>/dev/null || echo 0)"
  ahead="$(git rev-list --count "${upstream}..HEAD" 2>/dev/null || echo 0)"
  rem_version="$(git show "${upstream}:package.json" 2>/dev/null | read_pkg_version || true)"
  rem_version="${rem_version:-$cur_version}"
  rem_tag="$(git describe --tags --abbrev=0 "$upstream" 2>/dev/null || true)"
  dirty="$(git status --porcelain --untracked-files=no 2>/dev/null || true)"

  if [ "$behind" -eq 0 ] 2>/dev/null; then
    if [ "$ahead" -gt 0 ] 2>/dev/null; then
      echo "Version: v${cur_version} (${cur_branch}@${cur_sha}) — ${ahead} local commit(s) ahead of ${upstream}."
    else
      echo "Up to date: v${cur_version} (${cur_branch}@${cur_sha})."
    fi
    return 0
  fi

  echo ""
  echo "Update available from ${upstream}:"
  echo "  Current: v${cur_version} (${cur_branch}@${cur_sha})"
  if [ -n "$rem_tag" ]; then
    echo "  Target:  v${rem_version} (${upstream}@${rem_sha}, latest tag: ${rem_tag}, ${behind} commit(s) behind)"
  else
    echo "  Target:  v${rem_version} (${upstream}@${rem_sha}, ${behind} commit(s) behind)"
  fi
  echo "  Incoming commits:"
  git log --oneline -n 10 "HEAD..${upstream}" | sed 's/^/    - /'
  if [ "$behind" -gt 10 ]; then
    echo "    ... and $((behind - 10)) more commit(s)"
  fi
  echo ""

  if [ -n "$dirty" ]; then
    echo "WARNING: Tracked local files have uncommitted changes; skipping automatic git pull."
    echo "Commit or stash your changes to update from ${upstream}."
    return 0
  fi

  do_pull=0
  if [ "$AUTO_MODE" -eq 1 ]; then
    do_pull=1
    echo "Auto mode (--auto): pulling updates from ${upstream}..."
  elif [ "$INTERACTIVE" -eq 1 ]; then
    if prompt_yes_no "Pull v${rem_version} (${rem_sha}) from ${upstream} now?" "Y"; then
      do_pull=1
    else
      echo "Keeping current version v${cur_version} (${cur_sha})."
    fi
  else
    echo "Non-interactive run without --auto: skipping git pull (run './bin/start --auto' to auto-update)."
  fi

  if [ "$do_pull" -eq 1 ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "[dry-run] Would run: git pull --ff-only"
      return 0
    fi
    if git pull --ff-only; then
      new_sha="$(git rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
      echo "Updated to v${rem_version} (${new_sha}). Re-launching updated start script..."
      reexec_flags="--skip-update"
      [ "$AUTO_MODE" -eq 1 ] && reexec_flags="--auto ${reexec_flags}"
      [ "$CONFIGURE_MODE" -eq 1 ] && reexec_flags="${reexec_flags} --configure"
      [ "$DRY_RUN" -eq 1 ] && reexec_flags="${reexec_flags} --dry-run"
      eval "set -- ${reexec_flags} ${COMPOSE_ARGS}"
      exec "$0" "$@"
    else
      echo "WARNING: git pull --ff-only failed; continuing with current checkout." >&2
    fi
  fi
}

ensure_jwt_secrets() {
  cur_jwt="$(get_env_var "JWT_SECRET")"
  cur_refresh="$(get_env_var "JWT_REFRESH_SECRET")"
  if [ -z "$cur_jwt" ] || [ "$cur_jwt" = "$DEFAULT_JWT_SECRET" ]; then
    upsert_env_var "JWT_SECRET" "$(generate_secret)"
  fi
  if [ -z "$cur_refresh" ] || [ "$cur_refresh" = "$DEFAULT_JWT_REFRESH_SECRET" ]; then
    upsert_env_var "JWT_REFRESH_SECRET" "$(generate_secret)"
  fi
}

warn_if_http_public_url() {
  url_val="$1"
  lower_url="$(printf '%s' "$url_val" | tr '[:upper:]' '[:lower:]')"
  case "$lower_url" in
    http://*)
      echo ""
      echo "NOTE: Your PUBLIC_SERVER_URL starts with http:// (${url_val})."
      echo "      Release Android APKs block cleartext HTTP traffic and REQUIRE https://"
      echo "      (http:// works in web browsers and debug builds, not release APKs)."
      echo "      Use https:// (for example via Cloudflare Tunnel or a TLS reverse proxy) for mobile APK access."
      echo ""
      return 0
      ;;
  esac
  return 1
}

configure_env() {
  arch="$(uname -m)"
  is_arm64=0
  if [ "$arch" = "arm64" ] || [ "$arch" = "aarch64" ]; then
    is_arm64=1
  fi

  env_was_missing=0
  if [ ! -f .env ]; then
    env_was_missing=1
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "[dry-run] Would initialize .env from .env.example"
      return 0
    fi
    cp .env.example .env
    ensure_jwt_secrets
    if [ "$is_arm64" -eq 1 ]; then
      upsert_env_var "POSTGIS_IMAGE" "$DEFAULT_POSTGIS_ARM64"
    fi
  else
    if [ "$DRY_RUN" -eq 0 ]; then
      ensure_jwt_secrets
    fi
  fi

  cur_port="$(get_env_var "GATEWAY_PORT")"
  cur_port="${cur_port:-8080}"
  cur_public_url="$(get_env_var "PUBLIC_SERVER_URL")"
  cur_public_url="${cur_public_url:-http://localhost:${cur_port}}"
  cur_postgis="$(get_env_var "POSTGIS_IMAGE")"
  cur_postgis="${cur_postgis:-$DEFAULT_POSTGIS_AMD64}"
  cur_tunnel="$(get_env_var "CLOUDFLARE_TUNNEL_TOKEN")"

  # Check native ARM64 PostGIS even if .env already existed
  if [ "$is_arm64" -eq 1 ] && [ "$cur_postgis" = "$DEFAULT_POSTGIS_AMD64" ]; then
    if [ "$AUTO_MODE" -eq 1 ]; then
      if [ "$DRY_RUN" -eq 0 ]; then
        upsert_env_var "POSTGIS_IMAGE" "$DEFAULT_POSTGIS_ARM64"
      fi
      cur_postgis="$DEFAULT_POSTGIS_ARM64"
      echo "Auto mode (--auto): set POSTGIS_IMAGE=${DEFAULT_POSTGIS_ARM64} for native ${arch}."
    elif [ "$INTERACTIVE" -eq 1 ] && [ "$CONFIGURE_MODE" -eq 0 ] && [ "$env_was_missing" -eq 0 ]; then
      echo ""
      echo "Native ARM64 host detected (${arch}), but POSTGIS_IMAGE is set to ${cur_postgis} (amd64-only)."
      if prompt_yes_no "Switch POSTGIS_IMAGE to ${DEFAULT_POSTGIS_ARM64} for native ARM64 support?" "Y"; then
        if [ "$DRY_RUN" -eq 0 ]; then
          upsert_env_var "POSTGIS_IMAGE" "$DEFAULT_POSTGIS_ARM64"
        fi
        cur_postgis="$DEFAULT_POSTGIS_ARM64"
      fi
    fi
  fi

  [ "$INTERACTIVE" -eq 1 ] || return 0

  should_ask=0
  if [ "$env_was_missing" -eq 1 ] || [ "$CONFIGURE_MODE" -eq 1 ]; then
    should_ask=1
  else
    echo ""
    echo "Current .env configuration:"
    echo "  GATEWAY_PORT:            ${cur_port}"
    echo "  PUBLIC_SERVER_URL:       ${cur_public_url}"
    echo "  POSTGIS_IMAGE:           ${cur_postgis}"
    if [ -n "$cur_tunnel" ]; then
      echo "  CLOUDFLARE_TUNNEL_TOKEN: [set]"
    else
      echo "  CLOUDFLARE_TUNNEL_TOKEN: [not set]"
    fi
    if prompt_yes_no "Edit .env configuration now?" "N"; then
      should_ask=1
    fi
  fi

  [ "$should_ask" -eq 1 ] || return 0

  echo ""
  echo "--- Environment Setup (.env) ---"

  if [ "$is_arm64" -eq 1 ]; then
    echo "Native ARM64 host detected (${arch}) — e.g. Raspberry Pi 5."
    if prompt_yes_no "Use native ARM64 PostGIS image (${DEFAULT_POSTGIS_ARM64}) instead of ${DEFAULT_POSTGIS_AMD64}?" "Y"; then
      next_postgis="$DEFAULT_POSTGIS_ARM64"
    else
      next_postgis="$(prompt_value "POSTGIS_IMAGE" "$cur_postgis")"
    fi
    if [ "$DRY_RUN" -eq 0 ]; then
      upsert_env_var "POSTGIS_IMAGE" "$next_postgis"
    fi
    cur_postgis="$next_postgis"
  fi

  while true; do
    next_port="$(prompt_value "Gateway HTTP port (GATEWAY_PORT)" "$cur_port")"
    case "$next_port" in
      ''|*[!0-9]*)
        echo "Please enter a valid TCP port number (1-65535)."
        ;;
      *)
        if [ "$next_port" -ge 1 ] && [ "$next_port" -le 65535 ]; then
          break
        fi
        echo "Port must be between 1 and 65535."
        ;;
    esac
  done
  if [ "$cur_public_url" = "http://localhost:${cur_port}" ] && [ "$next_port" != "$cur_port" ]; then
    cur_public_url="http://localhost:${next_port}"
  fi
  cur_port="$next_port"
  [ "$DRY_RUN" -eq 0 ] && upsert_env_var "GATEWAY_PORT" "$cur_port"

  while true; do
    next_public_url="$(prompt_value "Public Server URL for QR invites & mobile (PUBLIC_SERVER_URL)" "$cur_public_url")"
    next_public_url="$(printf '%s' "$next_public_url" | sed 's:/*$::')"
    if warn_if_http_public_url "$next_public_url"; then
      if prompt_yes_no "Re-enter PUBLIC_SERVER_URL with https:// instead?" "N"; then
        continue
      fi
    fi
    cur_public_url="$next_public_url"
    break
  done
  [ "$DRY_RUN" -eq 0 ] && upsert_env_var "PUBLIC_SERVER_URL" "$cur_public_url"

  next_tunnel="$(prompt_value "Cloudflare Tunnel Token (CLOUDFLARE_TUNNEL_TOKEN)" "$cur_tunnel" 1)"
  cur_tunnel="$next_tunnel"
  [ "$DRY_RUN" -eq 0 ] && upsert_env_var "CLOUDFLARE_TUNNEL_TOKEN" "$cur_tunnel"
  if [ -n "$cur_tunnel" ]; then
    [ "$DRY_RUN" -eq 0 ] && upsert_env_var "TRUST_CLOUDFLARE_HEADERS" "true"
    echo "Cloudflare Tunnel token configured — will start with '--profile tunnel' and TRUST_CLOUDFLARE_HEADERS=true."
  fi

  if prompt_yes_no "Customize PostgreSQL credentials or SMTP email settings?" "N"; then
    cur_pg_user="$(get_env_var "POSTGRES_USER")"; cur_pg_user="${cur_pg_user:-postgres}"
    cur_pg_pass="$(get_env_var "POSTGRES_PASSWORD")"; cur_pg_pass="${cur_pg_pass:-postgres}"
    cur_pg_db="$(get_env_var "POSTGRES_DB")"; cur_pg_db="${cur_pg_db:-lovedones}"
    next_pg_user="$(prompt_value "POSTGRES_USER" "$cur_pg_user")"
    next_pg_pass="$(prompt_value "POSTGRES_PASSWORD" "$cur_pg_pass")"
    next_pg_db="$(prompt_value "POSTGRES_DB" "$cur_pg_db")"
    if [ "$DRY_RUN" -eq 0 ]; then
      upsert_env_var "POSTGRES_USER" "$next_pg_user"
      upsert_env_var "POSTGRES_PASSWORD" "$next_pg_pass"
      upsert_env_var "POSTGRES_DB" "$next_pg_db"
      upsert_env_var "DATABASE_URL" "postgresql://${next_pg_user}:${next_pg_pass}@localhost:5432/${next_pg_db}"
    fi

    cur_smtp_host="$(get_env_var "SMTP_HOST")"
    cur_smtp_port="$(get_env_var "SMTP_PORT")"; cur_smtp_port="${cur_smtp_port:-587}"
    cur_smtp_secure="$(get_env_var "SMTP_SECURE")"; cur_smtp_secure="${cur_smtp_secure:-false}"
    cur_smtp_user="$(get_env_var "SMTP_USER")"
    cur_smtp_pass="$(get_env_var "SMTP_PASS")"
    cur_smtp_from="$(get_env_var "SMTP_FROM")"; cur_smtp_from="${cur_smtp_from:-LovedOnes <noreply@localhost>}"
    next_smtp_host="$(prompt_value "SMTP_HOST" "$cur_smtp_host")"
    next_smtp_port="$(prompt_value "SMTP_PORT" "$cur_smtp_port")"
    next_smtp_secure="$(prompt_value "SMTP_SECURE (true/false)" "$cur_smtp_secure")"
    next_smtp_user="$(prompt_value "SMTP_USER" "$cur_smtp_user")"
    next_smtp_pass="$(prompt_value "SMTP_PASS" "$cur_smtp_pass" 1)"
    next_smtp_from="$(prompt_value "SMTP_FROM" "$cur_smtp_from")"
    if [ "$DRY_RUN" -eq 0 ]; then
      upsert_env_var "SMTP_HOST" "$next_smtp_host"
      upsert_env_var "SMTP_PORT" "$next_smtp_port"
      upsert_env_var "SMTP_SECURE" "$next_smtp_secure"
      upsert_env_var "SMTP_USER" "$next_smtp_user"
      upsert_env_var "SMTP_PASS" "$next_smtp_pass"
      upsert_env_var "SMTP_FROM" "$next_smtp_from"
    fi
  fi

  echo "Saved .env configuration."
}

fetch_latest_protomaps_url() {
  json=""
  if command -v curl >/dev/null 2>&1; then
    json="$(curl -sfL --max-time 15 "$BUILDS_METADATA_URL" 2>/dev/null || true)"
  elif command -v wget >/dev/null 2>&1; then
    json="$(wget -qO- --timeout=15 "$BUILDS_METADATA_URL" 2>/dev/null || true)"
  fi
  [ -n "$json" ] || return 1
  latest_key="$(printf '%s' "$json" | grep -oE '[0-9]{8}\.pmtiles' | tail -n 1 || true)"
  [ -n "$latest_key" ] || return 1
  printf 'https://build.protomaps.com/%s' "$latest_key"
}

compute_bbox_from_center() {
  lat="$1"
  lon="$2"
  radius_km="$3"
  awk -v lat="$lat" -v lon="$lon" -v r="$radius_km" '
    BEGIN {
      pi = 3.14159265358979323846
      dlat = r / 111.32
      cos_lat = cos(lat * pi / 180.0)
      if (cos_lat < 0.15) cos_lat = 0.15
      dlon = r / (111.32 * cos_lat)
      min_lon = lon - dlon; max_lon = lon + dlon
      min_lat = lat - dlat; max_lat = lat + dlat
      if (min_lon < -180) min_lon = -180
      if (max_lon > 180) max_lon = 180
      if (min_lat < -85) min_lat = -85
      if (max_lat > 85) max_lat = 85
      printf "%.5f,%.5f,%.5f,%.5f", min_lon, min_lat, max_lon, max_lat
    }
  '
}

validate_bbox() {
  bbox_in="$1"
  awk -v s="$bbox_in" '
    BEGIN {
      n = split(s, a, ",")
      if (n != 4) exit 1
      for (i = 1; i <= 4; i++) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", a[i])
        if (a[i] !~ /^-?[0-9]+(\.[0-9]+)?$/) exit 1
      }
      min_lon = a[1] + 0; min_lat = a[2] + 0; max_lon = a[3] + 0; max_lat = a[4] + 0
      if (min_lon < -180 || max_lon > 180 || min_lon >= max_lon) exit 1
      if (min_lat < -85 || max_lat > 85 || min_lat >= max_lat) exit 1
      printf "%.5f,%.5f,%.5f,%.5f", min_lon, min_lat, max_lon, max_lat
    }
  '
}

maybe_download_base_tiles() {
  [ "$INTERACTIVE" -eq 1 ] || return 0

  tiles_file="infra/tiles/region.pmtiles"
  tiles_size=0
  if [ -f "$tiles_file" ]; then
    tiles_size="$(wc -c < "$tiles_file" | tr -d ' ')"
  fi

  if [ "$tiles_size" -gt 1024 ] 2>/dev/null; then
    mb="$(awk -v b="$tiles_size" 'BEGIN { printf "%.1f", b / (1024 * 1024) }')"
    echo ""
    echo "Base map tiles already present at ${tiles_file} (${mb} MB)."
    if [ "$CONFIGURE_MODE" -eq 0 ]; then
      return 0
    fi
    if ! prompt_yes_no "Replace ${tiles_file} with a new regional extract?" "N"; then
      return 0
    fi
  else
    echo ""
    echo "Map tiles at ${tiles_file} are currently the 264-byte stub (pins render on a blank canvas until regional tiles are downloaded)."
    if ! prompt_yes_no "Pre-download base map tiles into ${tiles_file} now?" "N"; then
      echo "Skipping tile download — you can also download city regions later from /admin or via pmtiles CLI."
      return 0
    fi
  fi

  echo ""
  echo "Find your area's coordinates or bounding box using:"
  echo "  - Mapbox Playground / Location tools: https://docs.mapbox.com/playground/static/"
  echo "  - Bounding Box Picker (copy Box):   https://bboxfinder.com"
  echo ""
  echo "Enter EITHER:"
  echo "  1) Bounding box as minLon,minLat,maxLon,maxLat  (e.g. 13.00,52.30,13.80,52.70)"
  echo "  2) Center coordinates as lat,lon                (e.g. 52.5200,13.4050)"

  target_bbox=""
  while true; do
    printf 'Coordinates or bbox (Enter to cancel): '
    IFS= read -r coord_input || coord_input=""
    coord_input="$(printf '%s' "$coord_input" | tr -d '\r' | awk '{$1=$1;print}')"
    if [ -z "$coord_input" ]; then
      echo "Cancelled base tile download."
      return 0
    fi

    comma_count="$(printf '%s' "$coord_input" | awk -F',' '{print NF - 1}')"
    if [ "$comma_count" -eq 3 ]; then
      if parsed_bbox="$(validate_bbox "$coord_input")"; then
        target_bbox="$parsed_bbox"
        break
      fi
      echo "Invalid bounding box. Use minLon,minLat,maxLon,maxLat (with min < max)."
    elif [ "$comma_count" -eq 1 ]; then
      c_lat="$(printf '%s' "$coord_input" | cut -d, -f1 | awk '{$1=$1;print}')"
      c_lon="$(printf '%s' "$coord_input" | cut -d, -f2 | awk '{$1=$1;print}')"
      if awk -v la="$c_lat" -v lo="$c_lon" 'BEGIN {
        if (la !~ /^-?[0-9]+(\.[0-9]+)?$/ || lo !~ /^-?[0-9]+(\.[0-9]+)?$/) exit 1
        if (la < -85 || la > 85 || lo < -180 || lo > 180) exit 1
      }'; then
        while true; do
          radius_km="$(prompt_value "Extract radius in km around (${c_lat}, ${c_lon})" "25")"
          if awk -v r="$radius_km" 'BEGIN { if (r !~ /^[0-9]+(\.[0-9]+)?$/ || r <= 0 || r > 500) exit 1 }'; then
            target_bbox="$(compute_bbox_from_center "$c_lat" "$c_lon" "$radius_km")"
            echo "Computed bounding box: ${target_bbox}"
            break
          fi
          echo "Radius must be a number between 1 and 500 km."
        done
        break
      else
        echo "Invalid lat,lon pair."
      fi
    else
      echo "Enter either 4 comma-separated bbox values (minLon,minLat,maxLon,maxLat) or 2 center values (lat,lon)."
    fi
  done

  echo "Resolving latest Protomaps basemap build..."
  source_url="$(fetch_latest_protomaps_url || true)"
  if [ -z "$source_url" ]; then
    echo "Could not resolve ${BUILDS_METADATA_URL} automatically."
    source_url="$(prompt_value "Enter direct .pmtiles source URL (or Enter to skip)" "")"
    if [ -z "$source_url" ]; then
      echo "Skipping tile download."
      return 0
    fi
  fi
  echo "Source archive: ${source_url}"
  echo "Target bbox:    ${target_bbox}"

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "[dry-run] Would extract ${source_url} (--bbox=${target_bbox}) into ${tiles_file}"
    return 0
  fi

  tmp_rel="infra/tiles/region.pmtiles.tmp"
  rm -f "$tmp_rel"

  if command -v pmtiles >/dev/null 2>&1; then
    echo "Extracting regional tiles with local pmtiles CLI..."
    if pmtiles extract "$source_url" "$tmp_rel" --bbox="$target_bbox" --maxzoom=15 --download-threads=6 --overfetch=0.05; then
      mv "$tmp_rel" "$tiles_file"
    else
      rm -f "$tmp_rel"
      echo "WARNING: Tile extract failed; keeping existing ${tiles_file}." >&2
      return 0
    fi
  else
    echo "Local pmtiles CLI not found — building auth-admin-service image to extract tiles via Docker..."
    if docker compose build auth-admin-service \
      && docker compose run --rm --no-deps -T auth-admin-service \
        pmtiles extract "$source_url" "/srv/tiles/region.pmtiles.tmp" \
        --bbox="$target_bbox" --maxzoom=15 --download-threads=6 --overfetch=0.05; then
      mv "$tmp_rel" "$tiles_file"
    else
      rm -f "$tmp_rel"
      echo "WARNING: Container tile extract failed; keeping existing ${tiles_file}." >&2
      return 0
    fi
  fi

  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git update-index --assume-unchanged "$tiles_file" 2>/dev/null || true
  fi
  new_mb="$(wc -c < "$tiles_file" | awk '{ printf "%.1f", $1 / (1024 * 1024) }')"
  echo "Downloaded base tiles to ${tiles_file} (${new_mb} MB)."
}

# ---- Execution ----

check_and_update_repo "$@"
configure_env
maybe_download_base_tiles

GATEWAY_PORT="$(get_env_var "GATEWAY_PORT")"
GATEWAY_PORT="${GATEWAY_PORT:-8080}"
PUBLIC_SERVER_URL="$(get_env_var "PUBLIC_SERVER_URL")"
CLOUDFLARE_TUNNEL_TOKEN="$(get_env_var "CLOUDFLARE_TUNNEL_TOKEN")"

profile_args=""
case " ${COMPOSE_ARGS} " in
  *" '--profile' "*|*" --profile="*)
    ;;
  *)
    if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ]; then
      profile_args="'--profile' 'tunnel'"
    fi
    ;;
esac

if [ "$DRY_RUN" -eq 1 ]; then
  echo "[dry-run] Would run: docker compose ${profile_args} up -d --build ${COMPOSE_ARGS}"
  echo "Dry run complete (no containers modified)."
  exit 0
fi

eval "set -- ${profile_args} up -d --build ${COMPOSE_ARGS}"
DOCKER_BUILDKIT=1 COMPOSE_DOCKER_CLI_BUILD=1 docker compose "$@"

echo ""
echo "LovedOnes is running at http://localhost:${GATEWAY_PORT}"
if [ -n "$PUBLIC_SERVER_URL" ] && [ "$PUBLIC_SERVER_URL" != "http://localhost:${GATEWAY_PORT}" ]; then
  echo "Public origin configured: ${PUBLIC_SERVER_URL}"
fi
